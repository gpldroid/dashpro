# DashPro — Supabase public configuration
# Copy this file to .env.local and replace the placeholders with values
# from the Supabase Project > Connect dialog.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here

# Do not place SUPABASE_SECRET_KEY or service_role keys in this file.
# Trusted server-side secrets must be configured only in the deployment
# environment that needs them.
