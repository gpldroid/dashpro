# DashPro — public client configuration
# Copy this file to .env.local for local development.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here

# GitHub API calls must be performed through the authenticated backend/Edge
# Function in production. Never put a GitHub PAT or Supabase secret key in
# NEXT_PUBLIC_* variables or commit them to this repository.
#
# Optional server-side/Edge Function configuration:
# GITHUB_API_URL=https://api.github.com

# Never commit SUPABASE_SECRET_KEY, service_role keys, GitHub PATs,
# OAuth client secrets, or other private credentials.
